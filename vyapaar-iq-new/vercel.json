{
  "version": 2,
  "framework": null,
  "buildCommand": "npm --prefix settle-frontend ci --no-audit --no-fund && npm --prefix settle-frontend run build",
  "outputDirectory": "settle-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/handler"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
